{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/service-worker", "src/service-worker.ts", "src/**/*.test.ts"]
}
