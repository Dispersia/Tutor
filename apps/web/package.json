{
  "name": "@tutor/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun scripts/sync-vad-assets.mjs && vite dev",
    "build": "bun scripts/sync-vad-assets.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "vad": "bun scripts/sync-vad-assets.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "latest",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "latest",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.31"
  }
}
