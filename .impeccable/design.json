  "narrative": {
    "northStar": "Nightforge.",
    "overview": "A game you actually want to open every day. The room is graphite — a neutral dark with the faintest cool cast, never warm brown — and the interface is flat: colour, borders and type do the work, and nothing glows. One amber carries the single action that moves the session forward. Everything the player earned is set in brass gold. The professions keep four muted category hues — jade grows, brass is the artisan, violet is support, ember is combat — and azure is the academy. Colour is a role, never a mood. The signature is the character cell: every studied glyph sits on a ruled, accent-tinted square, and the language is always set in a serif that matches its script.",
    "keyCharacteristics": [
      "Neutral graphite ladder (ink-950 to ink-100), no warm cast, no gradients",
      "One amber action; brass gold for earned figures; four muted category hues",
      "Generous radii (10-14px), hairline borders, one soft shadow — flat, not skeuomorphic",
      "Mobile-first single column with a bottom tab bar; desktop opens into a rail + wider spread",
      "A self-hosted type system that covers Latin, CJK, kana, Hangul, Bopomofo and Cyrillic"
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "section": "colors",
        "body": "A surface carries exactly one accent, set through --accent; tints and borders derive from it with color-mix. Two accents in one panel is a bug, not a flourish."
      },
      {
        "name": "The Muted Rule",
        "section": "colors",
        "body": "Accents are deliberately desaturated (chroma ~0.09-0.15) so the hues sit beside each other instead of shouting across the screen."
      },
      {
        "name": "The Flat Rule",
        "section": "colors",
        "body": "No gradients, no glows, no glassmorphism. Separation comes from the surface ladder, a 1px border and one soft shadow."
      },
      {
        "name": "The Cell Holds The Word Rule",
        "section": "colors",
        "body": "The character cell is reserved for language."
      },
      {
        "name": "The Serif-For-Earned Rule",
        "section": "typography",
        "body": "If it is a number the player earned, it is set in the display face with tabular figures. Sentences are sans."
      },
      {
        "name": "The Caps-Tracking Rule",
        "section": "typography",
        "body": "Uppercase is reserved for the tracked label and button copy, and always carries at least 0.06em of letter-spacing."
      },
      {
        "name": "The CJK-Leading Rule",
        "section": "typography",
        "body": "CJK glyphs fill the em box, so language text takes a looser leading (>=1.3 display, >=1.5 body) and zero tracking."
      },
      {
        "name": "The Flat-By-Default Rule",
        "section": "elevation",
        "body": "If a surface seems to float, it is wrong; lower its fill instead of adding a shadow."
      }
    ],
    "dos": [
      "Assign colour through --accent per surface, so tints and borders derive from one hue.",
      "Set earned numbers in the display face with tabular figures, brass gold when they are XP, streak, rank or currency.",
      "Keep the character cell for language only, and Seal Amber for the one forward action.",
      "Convey depth with one lightness step plus a 1px hairline.",
      "Keep colour semantic: jade grows, brass earns, azure is the academy, violet is support, ember is combat.",
      "Set language text in a serif that matches its script, with CJK leading and zero tracking.",
      "Draw icons as one stroke and weight."
    ],
    "donts": [
      "Don't add gradients, glows, coloured drop shadows, or glassmorphism.",
      "Don't put two accents in one panel, or use gold as a fill behind body text.",
      "Don't set body copy in the display face, or uppercase anything without 0.06em of tracking.",
      "Don't apply negative tracking to CJK, or Latin leading to CJK display text.",
      "Don't use the character cell as a generic container.",
      "Don't let a disabled control keep its accent colour."
    ]
  }
}
