# Copy to ~/.config/tutor/env (chmod 600) or .env for dev.
# The app reads these at startup. Never commit real keys.

# OpenRouter key. The app lets you pick which model fills each role in the UI.
OPENROUTER_API_KEY=sk-or-...

# Where SQLite + audio history live.
TUTOR_DATA_DIR=./data
# Where MLX/HF model weights are cached (multi-GB).
TUTOR_MODELS_DIR=./models

# Speech gateway lifecycle (see docs/DESIGN.md §8).
TUTOR_SPEECH_IDLE_TIMEOUT=600
TUTOR_SPEECH_AUTOSTART=false
TUTOR_SPEECH_PORT=4319

# Server
TUTOR_PORT=4318
# Optional: local HTTPS for Android mic (see docs/DESIGN.md §14.1)
# TUTOR_TLS_CERT=./data/tls/tutor.pem
# TUTOR_TLS_KEY=./data/tls/tutor-key.pem
