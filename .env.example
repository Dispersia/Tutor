# Copy to ~/.config/tutor/env (chmod 600) or .env for dev.
# The app reads these at startup. Never commit real keys.
# Every variable the code reads is listed here; commented lines show the default.

# --- OpenRouter (the brain) ---------------------------------------------------
# Server-level key, used by members who have not saved their own in Settings.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model per role (each member can change theirs in Settings).
# TUTOR_MODEL_CONVERSATION=qwen/qwen3.8-27b
# TUTOR_MODEL_JUDGE=qwen/qwen3.8-27b
# TUTOR_MODEL_GENERATOR=qwen/qwen3.8-flash
# TUTOR_MODEL_TRANSLATOR=qwen/qwen3.8-flash

# --- Paths (a relative path is resolved against the repo root) -----------------
# Where SQLite + recorded audio live.
TUTOR_DATA_DIR=./data
# Where MLX/HF model weights are cached (multi-GB).
TUTOR_MODELS_DIR=./models
# TUTOR_STATIC_DIR=./apps/web/build
# TUTOR_PYTHON_DIR=./python

# --- Server --------------------------------------------------------------------
# TUTOR_HOST=127.0.0.1
TUTOR_PORT=4318
# Serve under a prefix (e.g. /tutor behind a tailnet gateway). Must match the
# base path the web build was made with — see deploy/README.md.
# TUTOR_BASE_PATH=

# --- Multi-user (docs/DESIGN.md §12.5) -----------------------------------------
# Encrypts per-user OpenRouter keys at rest. Set to a long random string.
# TUTOR_SECRET=change-me-to-a-long-random-string
# Close registration once everyone has an account (first user is always admin).
TUTOR_ALLOW_REGISTRATION=true
TUTOR_SESSION_TTL_DAYS=30

# --- Speech gateway (docs/DESIGN.md §8) ----------------------------------------
TUTOR_SPEECH_PORT=4319
# TUTOR_SPEECH_URL=http://127.0.0.1:4319
TUTOR_SPEECH_IDLE_TIMEOUT=3600
TUTOR_SPEECH_AUTOSTART=false
# Read by the Python gateway itself:
# TUTOR_SPEECH_EXIT_ON_IDLE=true
# TUTOR_LOG_LEVEL=INFO
# TUTOR_ASR=mlx-community/whisper-large-v3-turbo-asr-fp16
# TUTOR_ASR_LITE=            (defaults to TUTOR_ASR)
# TUTOR_ALIGN=mlx-community/Qwen3-ForcedAligner-0.6B-8bit
# TUTOR_TTS_PRESET=mlx-community/VoxCPM2-8bit
# TUTOR_TTS_ATTEMPTS=3
# TUTOR_TTS_CLEAR_EVERY=5

# --- Web push ------------------------------------------------------------------
# VAPID contact (a mailto: or https: URL) sent to the browser push services.
# TUTOR_PUSH_SUBJECT=mailto:push@localhost

# --- Optional: local HTTPS for the Android mic (docs/DESIGN.md §14.1) ----------
# TUTOR_TLS_CERT=./data/tls/tutor.pem
# TUTOR_TLS_KEY=./data/tls/tutor-key.pem
