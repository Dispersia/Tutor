<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.tutor.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>@REPO@/deploy/tutor-serve.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@REPO@</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/tutor.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/tutor.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
